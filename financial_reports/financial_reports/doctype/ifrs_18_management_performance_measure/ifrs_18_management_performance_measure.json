 "permissions": [
  {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
  {"role": "Accounts User", "read": 1, "report": 1}
 ],
 "field_order": ["measure_name", "company", "active", "definition_section", "comparable_subtotal", "reason_for_use", "calculation_description", "public_communication_reference", "adjustments_section", "adjustments", "change_section", "change_explanation"],
 "fields": [
  {"fieldname": "measure_name", "fieldtype": "Data", "label": "Measure name", "reqd": 1, "unique": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
  {"default": "1", "fieldname": "active", "fieldtype": "Check", "label": "Active"},
  {"fieldname": "definition_section", "fieldtype": "Section Break", "label": "IFRS 18 disclosures"},
  {"fieldname": "comparable_subtotal", "fieldtype": "Select", "label": "Most directly comparable IFRS subtotal", "options": "Operating profit\nProfit before financing and income taxes\nProfit before income tax\nProfit from continuing operations\nProfit", "reqd": 1},
