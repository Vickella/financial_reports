  {"fieldname": "calculation_description", "fieldtype": "Small Text", "label": "How the measure is calculated", "reqd": 1},
  {"fieldname": "public_communication_reference", "fieldtype": "Data", "label": "Public communication reference"},
  {"fieldname": "adjustments_section", "fieldtype": "Section Break", "label": "Reconciliation adjustments"},
  {"fieldname": "adjustments", "fieldtype": "Table", "label": "Adjustments", "options": "IFRS 18 MPM Adjustment"},
  {"fieldname": "change_section", "fieldtype": "Section Break", "label": "Changes"},
  {"description": "Explain changes to calculation, additions, cessations or label changes and the reasons for them.", "fieldname": "change_explanation", "fieldtype": "Small Text", "label": "Change explanation"}
 ]
}
